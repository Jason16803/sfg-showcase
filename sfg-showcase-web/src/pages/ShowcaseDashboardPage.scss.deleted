@use '@/styles/variables' as *;

.showcase-dashboard {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.showcase-dashboard__content {
  flex: 1;
  padding: $space-lg $space-md;

  @media (min-width: $breakpoint-lg) { padding: $space-xl; }
}

// ---------------------------------------------------------------------------
// Header
// ---------------------------------------------------------------------------

.showcase-dashboard__header {
  margin-bottom: $space-2xl;

  h1 {
    font-size: $font-size-3xl;
    margin-bottom: $space-sm;
  }

  p {
    font-size: $font-size-sm;
    color: $color-text-secondary;
    margin: 0;
    display: flex;
    align-items: center;
    gap: $space-sm;
  }
}

.showcase-dashboard__demo-badge {
  display: inline-flex;
  align-items: center;
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  color: $color-warning;
  background-color: rgba($color-warning, 0.1);
  border: 1px solid rgba($color-warning, 0.25);
  border-radius: 999px;
  padding: 1px 8px;
}

// ---------------------------------------------------------------------------
// Metrics
// ---------------------------------------------------------------------------

.showcase-dashboard__metrics {
  display: grid;
  gap: $space-lg;
  grid-template-columns: 1fr;
  margin-bottom: $space-2xl;

  @media (min-width: $breakpoint-md) { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: $breakpoint-lg) { grid-template-columns: repeat(4, 1fr); }
}

// ---------------------------------------------------------------------------
// Charts
// ---------------------------------------------------------------------------

.showcase-dashboard__charts {
  display: grid;
  gap: $space-lg;
  grid-template-columns: 1fr;
  margin-bottom: $space-2xl;

  @media (min-width: $breakpoint-lg) { grid-template-columns: repeat(3, 1fr); }
}

.showcase-dashboard__chart-card {
  background-color: $color-surface-card;
  border: 1px solid $color-border;
  border-radius: $radius-lg;
  padding: $space-lg;

  h3 {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    margin-bottom: $space-lg;
    color: $color-text-primary;
  }
}

// ---------------------------------------------------------------------------
// Jobs + Activity two-column
// ---------------------------------------------------------------------------

.showcase-dashboard__grid {
  display: grid;
  gap: $space-lg;
  grid-template-columns: 1fr;
  margin-bottom: $space-2xl;

  @media (min-width: $breakpoint-lg) { grid-template-columns: 2fr 1fr; }
}

.showcase-dashboard__jobs,
.showcase-dashboard__customers {
  background-color: $color-surface-card;
  border: 1px solid $color-border;
  border-radius: $radius-lg;
  overflow: hidden;
}

// ---------------------------------------------------------------------------
// Table header
// ---------------------------------------------------------------------------

.showcase-dashboard__table-header {
  padding: $space-lg;
  border-bottom: 1px solid $color-border;

  h3 {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: $color-text-primary;
    margin: 0;
  }
}

// ---------------------------------------------------------------------------
// Table styles
// ---------------------------------------------------------------------------

.showcase-dashboard__table {
  overflow-x: auto;

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: $font-size-sm;
  }

  thead tr {
    border-bottom: 1px solid $color-border;
  }

  th {
    padding: $space-sm $space-lg;
    text-align: left;
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: $color-text-muted;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  td {
    padding: $space-md $space-lg;
    color: $color-text-primary;
    border-bottom: 1px solid $color-border;
    vertical-align: middle;

    &:last-child { color: $color-text-secondary; }
  }

  tbody tr:last-child td { border-bottom: none; }

  tbody tr:hover td { background-color: rgba($color-primary, 0.03); }
}

// ---------------------------------------------------------------------------
// Activity feed (static, inline)
// ---------------------------------------------------------------------------

.showcase-activity {
  background-color: $color-surface-card;
  border: 1px solid $color-border;
  border-radius: $radius-lg;
  padding: $space-lg;
}

.showcase-activity__title {
  font-size: $font-size-base;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  margin-bottom: $space-lg;
}

.showcase-activity__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: $space-md;
}

.showcase-activity__item {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: $space-md;
  padding: $space-sm $space-md;
  border-radius: $radius-md;
  position: relative;
  transition: background-color $transition-base;

  &:hover { background-color: rgba($color-primary, 0.04); }
}

.showcase-activity__icon {
  width: 40px;
  height: 40px;
  border-radius: $radius-md;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: $font-size-base;
  flex-shrink: 0;

  &--primary { background-color: rgba($color-primary, 0.1); color: $color-primary; }
  &--success { background-color: rgba($color-success, 0.1); color: $color-success; }
  &--warning { background-color: rgba($color-warning, 0.1); color: $color-warning; }
  &--error   { background-color: rgba($color-error,   0.1); color: $color-error;   }
}

.showcase-activity__content {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.showcase-activity__label {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  margin: 0;
}

.showcase-activity__desc {
  font-size: $font-size-xs;
  color: $color-text-secondary;
  margin: 0;
  line-height: $line-height-normal;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.showcase-activity__time {
  font-size: $font-size-xs;
  color: $color-text-muted;
  margin-top: 2px;
}

.showcase-activity__connector {
  position: absolute;
  left: 19px;
  top: 42px;
  width: 2px;
  height: calc(100% + #{$space-md});
  background: linear-gradient(to bottom, $color-border, transparent);
}

// ---------------------------------------------------------------------------
// Customer table bottom
// ---------------------------------------------------------------------------

.showcase-dashboard__customers {
  margin-bottom: $space-2xl;
}
