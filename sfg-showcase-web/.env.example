# SFG Showcase Web - Environment Configuration
# Copy this to .env.local and fill in values for local development
# Do NOT commit .env.local

# SFO Core API base URL
# Must include the /api/v1 prefix — routes are mounted at /api/v1/*
# Example: http://localhost:3001/api/v1
VITE_API_URL=http://localhost:3001/api/v1

# Google OAuth configuration (placeholder for future implementation)
# Obtain from Google Cloud Console: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT storage key for localStorage
VITE_JWT_STORAGE_KEY=sfg_auth_token
