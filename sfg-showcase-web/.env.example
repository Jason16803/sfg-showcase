# ── SFO Core API ─────────────────────────────────────────────────────────────
#
# Base URL including the /api/v1 prefix. No trailing slash.
#
# Production (Vercel): set this in Vercel dashboard → Settings → Environment Variables
# Local dev (prod API): VITE_API_URL=https://sfo-core-api.fly.dev/api/v1
# Local dev (local API): VITE_API_URL=http://localhost:5000/api/v1
#
# Copy this file → .env.local (gitignored) and fill in your values.
# Never commit .env.local or .env to version control.
#
VITE_API_URL=https://sfo-core-api.fly.dev/api/v1

# ── Google OAuth ──────────────────────────────────────────────────────────────
#
# Public client ID from Google Cloud Console (browser-safe — not a secret).
# The client SECRET must only live on the SFO Core API backend, never here.
# Leave placeholder until POST /api/v1/auth/google is implemented on SFO Core.
#
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Auth token storage keys ───────────────────────────────────────────────────
#
# localStorage key for the JWT access token.
# Must match TOKEN_KEY in src/store/authStore.ts AND the backend seed script.
# Use sfg_access_token consistently across all environments.
#
VITE_JWT_STORAGE_KEY=sfg_access_token

# localStorage key for the refresh token.
# Defaults to VITE_JWT_STORAGE_KEY + '_refresh' if not set.
# Only set this if you need a non-default key.
# VITE_JWT_REFRESH_KEY=sfg_access_token_refresh
