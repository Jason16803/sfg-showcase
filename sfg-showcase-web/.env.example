# ── SFO Core API ─────────────────────────────────────────────────────────────
# Base URL including the /api/v1 prefix. No trailing slash.
# Local dev: http://localhost:3001/api/v1
# Production: set to the deployed Fly.io URL in Vercel environment settings
VITE_API_URL=http://localhost:3001/api/v1

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Public client ID from Google Cloud Console (safe to expose in browser bundle).
# The client SECRET lives on the SFO Core API backend only — never here.
# Leave blank until POST /api/v1/auth/google is implemented on SFO Core.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Auth token storage ────────────────────────────────────────────────────────
# localStorage key for the JWT access token (short-lived).
# Must match TOKEN_KEY in src/store/authStore.ts.
# Default: auth_token
VITE_JWT_STORAGE_KEY=auth_token

# localStorage key for the refresh token (longer-lived).
# Must match REFRESH_TOKEN_KEY in src/store/authStore.ts.
# Defaults to VITE_JWT_STORAGE_KEY + '_refresh' if not set.
# e.g. VITE_JWT_STORAGE_KEY=sfg_access_token → default is sfg_access_token_refresh
# VITE_JWT_REFRESH_KEY=sfg_refresh_token
