# Environment files — NEVER commit these
# .env         — contains real secrets/keys for local dev against production API
# .env.local   — local override; always gitignored by Vite convention
# .env.*.local — environment-specific local overrides
.env
.env.local
.env.*.local

# .env.example is intentionally committed — it contains placeholders only, no real values

